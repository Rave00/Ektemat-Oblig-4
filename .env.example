# Optional settings for Ekte Mat Online. Set them as environment variables; nothing here is required.
# Never commit real values: .env is in .gitignore.

# Key that signs the session cookie. If unset, a random key is created in instance/secret_key.
SECRET_KEY=

# Path to the SQLite database. If unset: instance/ektemat.db
DATABASE=

# Neo4j Aura MCP server, used by the Claude Code connector in .mcp.json.
# Copy "MCP URL" from the instance's Overview in the Aura console (https://<id>.mcp-instances.neo4j.io).
# Set it as a user environment variable (Windows: setx NEO4J_MCP_URL "..."), then restart Claude Code.
# No password here: Claude Code asks you to sign in with your Aura account the first time.
NEO4J_MCP_URL=
