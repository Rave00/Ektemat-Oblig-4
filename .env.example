# Optional settings for Ekte Mat Online. Set them as environment variables; nothing here is required.
# Never commit real values: .env is in .gitignore.

# Key that signs the session cookie. If unset, a random key is created in instance/secret_key.
SECRET_KEY=

# Path to the SQLite database. If unset: instance/ektemat.db
DATABASE=

# Neo4j, used by the Claude Code MCP connector in .mcp.json (needs uv: https://docs.astral.sh/uv/).
# Set these as user environment variables (Windows: setx NEO4J_URI "..."), then restart Claude Code.
# Get the real values from the team's password manager, never from the repo.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Optional. If unset: neo4j
NEO4J_DATABASE=
