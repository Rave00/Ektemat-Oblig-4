    <bpmndi:BPMNShape id="c_gw_m_di" bpmnElement="c_gw_m" ><dc:Bounds x="1562" y="72" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1538" y="126" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_rem_di" bpmnElement="c_rem" ><dc:Bounds x="1694" y="80" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1662" y="46" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_num_di" bpmnElement="c_num" ><dc:Bounds x="1782" y="64" width="110" height="66"/></bpmndi:BPMNShape>
