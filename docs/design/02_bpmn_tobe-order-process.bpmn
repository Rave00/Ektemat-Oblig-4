    <bpmndi:BPMNEdge id="seq_16_di" bpmnElement="seq_16"><di:waypoint x="838" y="572"/><di:waypoint x="838" y="482"/><di:waypoint x="1032" y="482"/><bpmndi:BPMNLabel><dc:Bounds x="844" y="520" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
