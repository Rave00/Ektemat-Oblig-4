    <bpmndi:BPMNShape id="s_inv_di" bpmnElement="s_inv" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="2158" y="450" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_end_di" bpmnElement="s_end" ><dc:Bounds x="2320" y="464" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2288" y="504" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
