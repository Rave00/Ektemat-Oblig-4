    <bpmndi:BPMNEdge id="seq_18_di" bpmnElement="seq_18"><di:waypoint x="1212" y="458"/><di:waypoint x="1212" y="368"/><di:waypoint x="1282" y="368"/><bpmndi:BPMNLabel><dc:Bounds x="1218" y="404" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="seq_19_di" bpmnElement="seq_19"><di:waypoint x="1238" y="482"/><di:waypoint x="1562" y="482"/><bpmndi:BPMNLabel><dc:Bounds x="1390" y="462" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="seq_20_di" bpmnElement="seq_20"><di:waypoint x="1392" y="368"/><di:waypoint x="1444" y="368"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="seq_21_di" bpmnElement="seq_21"><di:waypoint x="1480" y="368"/><di:waypoint x="1588" y="368"/><di:waypoint x="1588" y="458"/></bpmndi:BPMNEdge>
