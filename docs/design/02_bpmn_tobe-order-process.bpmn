    <bpmndi:BPMNShape id="c_end_di" bpmnElement="c_end" ><dc:Bounds x="2194" y="80" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2162" y="120" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start" ><dc:Bounds x="320" y="464" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="288" y="504" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_store_di" bpmnElement="s_store" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="408" y="450" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_cap_di" bpmnElement="s_cap" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="532" y="450" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="co_review_di" bpmnElement="co_review" ><dc:Bounds x="658" y="564" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="co_gw_di" bpmnElement="co_gw" ><dc:Bounds x="812" y="572" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="788" y="626" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="co_reject_di" bpmnElement="co_reject" ><dc:Bounds x="944" y="694" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="912" y="734" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_confirm_di" bpmnElement="s_confirm" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="1032" y="450" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_gw_dep_di" bpmnElement="s_gw_dep" ><dc:Bounds x="1188" y="458" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1162" y="512" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_dep_di" bpmnElement="s_dep" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="1282" y="334" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_paid_di" bpmnElement="s_paid" ><dc:Bounds x="1444" y="350" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1412" y="390" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
