    <bpmndi:BPMNShape id="s_rem_di" bpmnElement="s_rem" color:background-color="#dbe9f6" color:border-color="#2e6da4"><dc:Bounds x="1658" y="450" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="k_seen_di" bpmnElement="k_seen" ><dc:Bounds x="1782" y="794" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="k_prep_di" bpmnElement="k_prep" ><dc:Bounds x="1908" y="794" width="110" height="66"/></bpmndi:BPMNShape>
