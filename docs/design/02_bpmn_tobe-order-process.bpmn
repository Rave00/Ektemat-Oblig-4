<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_tobe" targetNamespace="https://github.com/Rave00/EkteMat-Online-Project" exporter="build_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="collab_tobe">
    <bpmn:participant id="p_customer" name="Customer" processRef="proc_p_customer"/>
    <bpmn:participant id="p_ektemat" name="Ekte Mat AS (with Ekte Mat Online)" processRef="proc_p_ektemat"/>
    <bpmn:participant id="p_fiken" name="Fiken (accounting system)"/>
    <bpmn:messageFlow id="msg_0" sourceRef="c_book" targetRef="s_start" name="booking request"/>
    <bpmn:messageFlow id="msg_1" sourceRef="s_store" targetRef="c_ack" name="acknowledgement"/>
    <bpmn:messageFlow id="msg_2" sourceRef="co_reject" targetRef="p_customer" name="rejection"/>
    <bpmn:messageFlow id="msg_3" sourceRef="s_confirm" targetRef="c_conf" name="confirmation"/>
    <bpmn:messageFlow id="msg_4" sourceRef="s_dep" targetRef="c_pay" name="payment request"/>
    <bpmn:messageFlow id="msg_5" sourceRef="c_pay" targetRef="s_paid" name="payment"/>
    <bpmn:messageFlow id="msg_6" sourceRef="s_rem" targetRef="c_rem" name="reminder"/>
    <bpmn:messageFlow id="msg_7" sourceRef="c_num" targetRef="p_ektemat" name="final numbers"/>
    <bpmn:messageFlow id="msg_8" sourceRef="d_del" targetRef="c_food" name="food"/>
    <bpmn:messageFlow id="msg_9" sourceRef="s_inv" targetRef="p_fiken" name="sale / EHF invoice"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_p_customer" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Catering needed"/>
    <bpmn:task id="c_book" name="Choose menu and send booking request online"/>
    <bpmn:intermediateCatchEvent id="c_ack" name="Acknowledgement received"><bpmn:messageEventDefinition id="c_ack_md"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_conf" name="Confirmation received"><bpmn:messageEventDefinition id="c_conf_md"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="c_gw" name="Deposit requested?"/>
    <bpmn:task id="c_pay" name="Pay deposit in Vipps"/>
    <bpmn:exclusiveGateway id="c_gw_m" name=""/>
    <bpmn:intermediateCatchEvent id="c_rem" name="Reminder received (7 days before)"><bpmn:messageEventDefinition id="c_rem_md"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="c_num" name="Confirm or change guest numbers online"/>
    <bpmn:intermediateCatchEvent id="c_food" name="Food received"><bpmn:messageEventDefinition id="c_food_md"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c_end" name="Event catered"/>
    <bpmn:sequenceFlow id="seq_0" sourceRef="c_start" targetRef="c_book"/>
    <bpmn:sequenceFlow id="seq_1" sourceRef="c_book" targetRef="c_ack"/>
    <bpmn:sequenceFlow id="seq_2" sourceRef="c_ack" targetRef="c_conf"/>
    <bpmn:sequenceFlow id="seq_3" sourceRef="c_conf" targetRef="c_gw"/>
    <bpmn:sequenceFlow id="seq_4" sourceRef="c_gw" targetRef="c_pay" name="yes"/>
    <bpmn:sequenceFlow id="seq_5" sourceRef="c_gw" targetRef="c_gw_m" name="no"/>
    <bpmn:sequenceFlow id="seq_6" sourceRef="c_pay" targetRef="c_gw_m"/>
    <bpmn:sequenceFlow id="seq_7" sourceRef="c_gw_m" targetRef="c_rem"/>
    <bpmn:sequenceFlow id="seq_8" sourceRef="c_rem" targetRef="c_num"/>
    <bpmn:sequenceFlow id="seq_9" sourceRef="c_num" targetRef="c_food"/>
    <bpmn:sequenceFlow id="seq_10" sourceRef="c_food" targetRef="c_end"/>
  </bpmn:process>
  <bpmn:process id="proc_p_ektemat" isExecutable="false">
    <bpmn:laneSet id="ls_p_ektemat">
      <bpmn:lane id="l_system" name="Ekte Mat Online">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_coord" name="Event coordinator">
        <bpmn:flowNodeRef>co_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>co_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>co_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>k_seen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_driver" name="Driver">
        <bpmn:flowNodeRef>d_del</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Booking request received"><bpmn:messageEventDefinition id="s_start_md"/></bpmn:startEvent>
    <bpmn:task id="s_store" name="Store request, confirm receipt"/>
    <bpmn:task id="s_cap" name="Check capacity for the date"/>
    <bpmn:task id="co_review" name="Review request (capacity shown)"/>
    <bpmn:exclusiveGateway id="co_gw" name="Approve?"/>
    <bpmn:endEvent id="co_reject" name="Request rejected (with reason)"><bpmn:messageEventDefinition id="co_reject_md"/></bpmn:endEvent>
    <bpmn:task id="s_confirm" name="Send confirmation, show status online"/>
    <bpmn:exclusiveGateway id="s_gw_dep" name="Wedding (deposit required)?"/>
    <bpmn:task id="s_dep" name="Request 30 % deposit via Vipps"/>
    <bpmn:intermediateCatchEvent id="s_paid" name="Deposit paid"><bpmn:messageEventDefinition id="s_paid_md"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="s_gw_m" name=""/>
    <bpmn:task id="s_rem" name="Send reminder 7 days before"/>
    <bpmn:task id="k_seen" name="Confirm allergies seen"/>
    <bpmn:task id="k_prep" name="Prepare food from kitchen screen"/>
    <bpmn:task id="d_del" name="Deliver and mark delivered on phone"/>
    <bpmn:task id="s_inv" name="Record sale in Fiken (EHF invoice or Vipps)"/>
    <bpmn:endEvent id="s_end" name="Order invoiced"/>
    <bpmn:sequenceFlow id="seq_11" sourceRef="s_start" targetRef="s_store"/>
    <bpmn:sequenceFlow id="seq_12" sourceRef="s_store" targetRef="s_cap"/>
    <bpmn:sequenceFlow id="seq_13" sourceRef="s_cap" targetRef="co_review"/>
    <bpmn:sequenceFlow id="seq_14" sourceRef="co_review" targetRef="co_gw"/>
    <bpmn:sequenceFlow id="seq_15" sourceRef="co_gw" targetRef="co_reject" name="no"/>
    <bpmn:sequenceFlow id="seq_16" sourceRef="co_gw" targetRef="s_confirm" name="yes"/>
    <bpmn:sequenceFlow id="seq_17" sourceRef="s_confirm" targetRef="s_gw_dep"/>
    <bpmn:sequenceFlow id="seq_18" sourceRef="s_gw_dep" targetRef="s_dep" name="yes"/>
    <bpmn:sequenceFlow id="seq_19" sourceRef="s_gw_dep" targetRef="s_gw_m" name="no"/>
    <bpmn:sequenceFlow id="seq_20" sourceRef="s_dep" targetRef="s_paid"/>
    <bpmn:sequenceFlow id="seq_21" sourceRef="s_paid" targetRef="s_gw_m"/>
    <bpmn:sequenceFlow id="seq_22" sourceRef="s_gw_m" targetRef="s_rem"/>
    <bpmn:sequenceFlow id="seq_23" sourceRef="s_rem" targetRef="k_seen"/>
    <bpmn:sequenceFlow id="seq_24" sourceRef="k_seen" targetRef="k_prep"/>
    <bpmn:sequenceFlow id="seq_25" sourceRef="k_prep" targetRef="d_del"/>
    <bpmn:sequenceFlow id="seq_26" sourceRef="d_del" targetRef="s_inv"/>
    <bpmn:sequenceFlow id="seq_27" sourceRef="s_inv" targetRef="s_end"/>
    <bpmn:textAnnotation id="note_legend"><bpmn:text>Blue = automated by Ekte Mat Online. Fiken is external (black-box pool). Vipps payments are shown as messages between customer and system. Changes before the deadline happen online at any time (US-12).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_tobe"><bpmndi:BPMNPlane id="plane_tobe" bpmnElement="collab_tobe">
    <bpmndi:BPMNShape id="p_customer_di" bpmnElement="p_customer" isHorizontal="true"><dc:Bounds x="80" y="40" width="2340" height="230"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="p_ektemat_di" bpmnElement="p_ektemat" isHorizontal="true"><dc:Bounds x="80" y="310" width="2340" height="690"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="l_system_di" bpmnElement="l_system" isHorizontal="true"><dc:Bounds x="110" y="310" width="2310" height="230"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="l_coord_di" bpmnElement="l_coord" isHorizontal="true"><dc:Bounds x="110" y="540" width="2310" height="230"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="l_kitchen_di" bpmnElement="l_kitchen" isHorizontal="true"><dc:Bounds x="110" y="770" width="2310" height="115"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="l_driver_di" bpmnElement="l_driver" isHorizontal="true"><dc:Bounds x="110" y="885" width="2310" height="115"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="p_fiken_di" bpmnElement="p_fiken" isHorizontal="true"><dc:Bounds x="80" y="1040" width="2340" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_start_di" bpmnElement="c_start" ><dc:Bounds x="194" y="80" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="162" y="120" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_book_di" bpmnElement="c_book" ><dc:Bounds x="282" y="64" width="110" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_ack_di" bpmnElement="c_ack" ><dc:Bounds x="444" y="80" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="412" y="46" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_conf_di" bpmnElement="c_conf" ><dc:Bounds x="1070" y="80" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1038" y="46" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_gw_di" bpmnElement="c_gw" ><dc:Bounds x="1188" y="72" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1162" y="38" width="100" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
