@startuml
' Generated by generators/build_usecase.py - edit the spec there, not here.
title Ekte Mat Online - use cases (from Must and Should stories)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F4E5A
}

actor "Customer" as Customer
actor "Private customer" as Private
actor "Corporate user" as Corporate
actor "Company administrator\n/ approver" as CompanyAdmin
rectangle "Ekte Mat Online" {
  package "Customer site" {
    usecase "UC01 Browse menu" as UC01
    usecase "UC02 Download quote" as UC02
    usecase "UC03 Submit booking request" as UC03
    usecase "UC04 Track order status" as UC04
    usecase "UC05 Change guests and allergies" as UC05
    usecase "UC06 Confirm final guest numbers" as UC06
    usecase "UC07 Cancel order" as UC07
    usecase "UC08 Reorder previous order" as UC08
    usecase "UC09 Ask question about order" as UC09
    usecase "UC10 Pay with Vipps" as UC10
    usecase "UC11 Request own data or deletion" as UC11
  }
  package "Company accounts" {
    usecase "UC12 Manage company users" as UC12
    usecase "UC13 Approve company order" as UC13
    usecase "UC14 Manage standing order" as UC14
  }
  package "Back office" {
    usecase "UC15 Handle booking requests" as UC15
    usecase "UC16 View capacity calendar" as UC16
    usecase "UC17 Register phone order" as UC17
    usecase "UC18 Answer customer question" as UC18
  }
  package "Kitchen and delivery" {
    usecase "UC19 View kitchen screen" as UC19
    usecase "UC20 Confirm allergies seen" as UC20
    usecase "UC21 Log in with PIN" as UC21
    usecase "UC22 Maintain menu and suppliers" as UC22
    usecase "UC23 View prep list" as UC23
    usecase "UC24 Complete deliveries" as UC24
  }
  package "Background jobs" {
    usecase "UC25 Send monthly EHF invoices" as UC25
    usecase "UC26 Sync sales and payments with Fiken" as UC26
    usecase "UC27 Apply retention and deletion rules" as UC27
  }
}
actor "Event coordinator" as Coordinator
actor "Kitchen staff" as Kitchen
actor "Driver" as Driver
actor "Scheduler" as Scheduler <<time>>
actor "Vipps" as Vipps <<system>>
actor "Fiken" as Fiken <<system>>

Customer <|-- Private
Customer <|-- Corporate
Corporate <|-- CompanyAdmin
Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
UC06 --> Scheduler
Customer --> UC07
Customer --> UC08
Customer --> UC09
Private --> UC10
UC10 --> Vipps
Customer --> UC11
CompanyAdmin --> UC12
CompanyAdmin --> UC13
Corporate --> UC14
UC15 <-- Coordinator
UC16 <-- Coordinator
UC17 <-- Coordinator
UC18 <-- Coordinator
UC19 <-- Kitchen
UC20 <-- Kitchen
UC21 <-- Kitchen
UC22 <-- Kitchen
UC23 <-- Kitchen
UC24 <-- Driver
UC25 <-- Scheduler
UC25 --> Fiken
UC26 <-- Scheduler
UC26 --> Fiken
UC27 <-- Scheduler
@enduml
