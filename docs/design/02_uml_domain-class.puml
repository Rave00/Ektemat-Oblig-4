@startuml
' Generated by generators/build_domain.py - edit the model there, not here.
title Ekte Mat Online - domain class diagram (from Must and Should stories)
hide methods
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E5A
  ArrowColor #1F4E5A
}
skinparam nodesep 35
skinparam ranksep 45

class Customer {
  name : String
  email : String [0..1] {unique}
  phone : String [0..1]
  language : Language
  hasLogin : Boolean
  lastOrderAt : DateTime [0..1]
}
class CompanyAccount {
  name : String
  orgNumber : String {unique}
  approvalLimitNok : Money [0..1]
  requiresCostCentre : Boolean
  closedAt : DateTime [0..1]
}
class CompanyMembership {
  role : CompanyRole
}
class StaffMember {
  name : String
  role : StaffRole
  pin : String [0..1]
}
class Address {
  street : String
  postcode : String
  city : String
}
class Order {
  orderNumber : String {unique}
  eventType : EventType
  eventDate : Date
  eventTime : Time [0..1]
  guestCount : Integer
  deliveryMethod : DeliveryMethod
  deliveryWindowStart : Time [0..1]
  deliveryWindowEnd : Time [0..1]
  channel : Channel
  status : OrderStatus
  paymentStatus : PaymentStatus
  costCentreCode : String [0..1]
  numbersConfirmed : Boolean
  submittedAt : DateTime
  firstRepliedAt : DateTime [0..1]
}
class GuestGroup {
  description : String
  size : Integer
  allergyNotes : Text [0..1]
  dietNotes : Text [0..1]
}
class OrderLine {
  quantity : Integer
  unitPriceNok : Money
}
class Dish {
  nameNo : String
  nameEn : String [0..1]
  descriptionNo : Text
  descriptionEn : Text [0..1]
  pricePerPersonNok : Money
  eventTypes : EventType [1..*]
  isChildrenDish : Boolean
  published : Boolean
}
class Allergen {
  code : String {unique}
  nameNo : String
  nameEn : String
}
class DietaryLabel {
  code : String {unique}
  nameNo : String
  nameEn : String
}
class Ingredient {
  name : String {unique}
}
class RecipeLine {
  quantityPerPortionKg : Decimal
}
class Supplier {
  name : String
  place : String
}
class AllergyConfirmation {
  confirmedAt : DateTime
}
class OrderChange {
  changedAt : DateTime
  field : String
  oldValue : String [0..1]
  newValue : String [0..1]
}
class Payment {
  kind : PaymentKind
  amountNok : Money
  state : PaymentState
  vippsReference : String [0..1]
  paidAt : DateTime [0..1]
}
class Invoice {
  invoiceNumber : String {unique}
  periodMonth : Date
  fikenInvoiceId : String [0..1]
  sentAt : DateTime [0..1]
  paidAt : DateTime [0..1]
}
class StandingOrder {
  weekday : Weekday
  startDate : Date
  endDate : Date [0..1]
  guestCount : Integer
  costCentreCode : String [0..1]
  active : Boolean
}
class StandingOrderLine {
  quantity : Integer
}
class Quote {
  quoteNumber : String {unique}
  createdAt : DateTime
  validUntil : Date
  totalNok : Money
}
class OrderQuestion {
  question : Text
  askedAt : DateTime
  answer : Text [0..1]
  answeredAt : DateTime [0..1]
}

note as EnumNote
Enumeration types (OrderStatus, EventType, ...)
are listed in 02_uml_domain-enums.png
end note

CompanyAccount "1" *-- "1..*" CompanyMembership : has members
Customer "1" -- "0..1" CompanyMembership : is member
Customer "1" -- "0..*" Order : places
Customer "0..1" -- "0..*" Order : approves (approved by)
CompanyAccount "0..1" -- "0..*" Order : is billed for
Address "0..1" -- "0..*" Order : is used for (delivery)
Order "1" *-- "1..*" GuestGroup : has
Order "1" *-- "1..*" OrderLine : contains
Dish "1" -- "0..*" OrderLine : ordered in
Dish "*" -- "*" Allergen : contains
Dish "*" -- "*" DietaryLabel : labelled
Dish "1" *-- "0..*" RecipeLine : recipe
Ingredient "1" -- "0..*" RecipeLine : used in
Supplier "0..1" -- "0..*" Ingredient : supplies
Order "1" *-- "0..*" AllergyConfirmation : allergies confirmed by
StaffMember "1" -- "0..*" AllergyConfirmation : gives (confirmed by)
Order "1" *-- "0..*" OrderChange : change log
Order "1" -- "0..*" Payment : paid by
CompanyAccount "1" -- "0..*" Invoice : receives
Invoice "0..1" -- "1..*" Order : includes
CompanyAccount "1" -- "0..*" StandingOrder : has
Customer "1" -- "0..*" StandingOrder : sets up (created by)
StandingOrder "1" *-- "1..*" StandingOrderLine : contains
Dish "1" -- "0..*" StandingOrderLine : ordered in
StandingOrder "0..1" -- "0..*" Order : generates
Customer "1" -- "0..*" Quote : requests
Quote "0..1" -- "0..*" Order : basis for
Order "1" *-- "0..*" OrderQuestion : questions
StaffMember "0..1" -- "0..*" OrderQuestion : answers (answered by)
note bottom of GuestGroup
Allergies and diets are stored per guest group,
never per named guest (GDPR art. 9, US-40).
end note
note bottom of Order
Daily capacity (derived, not stored):
400 covers per day, 250 if a served wedding
dinner is booked that day (US-18).
end note
@enduml
