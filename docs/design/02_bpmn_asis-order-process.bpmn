<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_asis" targetNamespace="https://example.org/ektemat-online" exporter="build_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="collab_asis">
    <bpmn:participant id="p_customer" name="Customer" processRef="proc_p_customer"/>
    <bpmn:participant id="p_ektemat" name="Ekte Mat AS (today)" processRef="proc_p_ektemat"/>
    <bpmn:messageFlow id="msg_0" sourceRef="c_send" targetRef="e_start" name="inquiry"/>
    <bpmn:messageFlow id="msg_1" sourceRef="e_end_alt" targetRef="p_customer" name="other date"/>
    <bpmn:messageFlow id="msg_2" sourceRef="e_quote" targetRef="c_quote" name="quote (PDF)"/>
    <bpmn:messageFlow id="msg_3" sourceRef="c_accept" targetRef="e_acc" name="acceptance"/>
    <bpmn:messageFlow id="msg_4" sourceRef="e_dep" targetRef="p_customer" name="deposit request"/>
    <bpmn:messageFlow id="msg_5" sourceRef="c_change" targetRef="e_chg" name="changes"/>
    <bpmn:messageFlow id="msg_6" sourceRef="e_call" targetRef="c_call" name="phone call"/>
    <bpmn:messageFlow id="msg_7" sourceRef="d_del" targetRef="c_food" name="food"/>
    <bpmn:messageFlow id="msg_8" sourceRef="e_inv" targetRef="c_inv" name="invoice"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_p_customer" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Catering needed"/>
    <bpmn:task id="c_send" name="Send inquiry by e-mail or phone"/>
    <bpmn:intermediateCatchEvent id="c_quote" name="Quote received"><bpmn:messageEventDefinition id="c_quote_md"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="c_accept" name="Accept quote by e-mail"/>
    <bpmn:task id="c_change" name="Phone or e-mail changes"/>
    <bpmn:intermediateCatchEvent id="c_call" name="Confirmation call received"><bpmn:messageEventDefinition id="c_call_md"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_food" name="Food received"><bpmn:messageEventDefinition id="c_food_md"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_inv" name="Invoice or Vipps request received"><bpmn:messageEventDefinition id="c_inv_md"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="c_pay" name="Pay"/>
    <bpmn:endEvent id="c_end" name="Order paid"/>
    <bpmn:sequenceFlow id="seq_0" sourceRef="c_start" targetRef="c_send"/>
    <bpmn:sequenceFlow id="seq_1" sourceRef="c_send" targetRef="c_quote"/>
    <bpmn:sequenceFlow id="seq_2" sourceRef="c_quote" targetRef="c_accept"/>
    <bpmn:sequenceFlow id="seq_3" sourceRef="c_accept" targetRef="c_change"/>
    <bpmn:sequenceFlow id="seq_4" sourceRef="c_change" targetRef="c_call"/>
    <bpmn:sequenceFlow id="seq_5" sourceRef="c_call" targetRef="c_food"/>
    <bpmn:sequenceFlow id="seq_6" sourceRef="c_food" targetRef="c_inv"/>
    <bpmn:sequenceFlow id="seq_7" sourceRef="c_inv" targetRef="c_pay"/>
    <bpmn:sequenceFlow id="seq_8" sourceRef="c_pay" targetRef="c_end"/>
  </bpmn:process>
  <bpmn:process id="proc_p_ektemat" isExecutable="false">
    <bpmn:laneSet id="ls_p_ektemat">
      <bpmn:lane id="l_coord" name="Event coordinator">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_excel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_wed_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>k_prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_driver" name="Driver">
        <bpmn:flowNodeRef>d_del</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_owner" name="Owner">
        <bpmn:flowNodeRef>o_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Inquiry received [P1]"><bpmn:messageEventDefinition id="e_start_md"/></bpmn:startEvent>
    <bpmn:task id="e_read" name="Read inquiry [P2]"/>
    <bpmn:task id="e_cap" name="Check Google Calendar for capacity [P3]"/>
    <bpmn:exclusiveGateway id="e_gw_cap" name="Capacity on the date?"/>
    <bpmn:endEvent id="e_end_alt" name="Other date proposed"><bpmn:messageEventDefinition id="e_end_alt_md"/></bpmn:endEvent>
    <bpmn:task id="e_quote" name="Write quote in Word, e-mail as PDF [P4]"/>
    <bpmn:intermediateCatchEvent id="e_acc" name="Acceptance received"><bpmn:messageEventDefinition id="e_acc_md"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="e_excel" name="Add order row to Excel sheet [P5]"/>
    <bpmn:exclusiveGateway id="e_gw_wed" name="Wedding?"/>
    <bpmn:task id="e_dep" name="Send Vipps deposit request [P6]"/>
    <bpmn:exclusiveGateway id="e_gw_wed_m" name=""/>
    <bpmn:task id="e_print" name="Print order, pin on kitchen board [P7]"/>
    <bpmn:task id="e_chg" name="Update Excel and re-print changes [P8]"/>
    <bpmn:task id="e_call" name="Phone customer to confirm final numbers [P9]"/>
    <bpmn:task id="k_prep" name="Prepare food from printed order [P10]"/>
    <bpmn:task id="d_del" name="Deliver food (address from printout) [P11]"/>
    <bpmn:task id="e_inv" name="Create invoice in Fiken or Vipps request [P12]"/>
    <bpmn:task id="o_rec" name="Reconcile Fiken with Excel (monthly) [P13]"/>
    <bpmn:endEvent id="o_end" name="Order closed"/>
    <bpmn:sequenceFlow id="seq_9" sourceRef="e_start" targetRef="e_read"/>
    <bpmn:sequenceFlow id="seq_10" sourceRef="e_read" targetRef="e_cap"/>
    <bpmn:sequenceFlow id="seq_11" sourceRef="e_cap" targetRef="e_gw_cap"/>
    <bpmn:sequenceFlow id="seq_12" sourceRef="e_gw_cap" targetRef="e_end_alt" name="no"/>
    <bpmn:sequenceFlow id="seq_13" sourceRef="e_gw_cap" targetRef="e_quote" name="yes"/>
    <bpmn:sequenceFlow id="seq_14" sourceRef="e_quote" targetRef="e_acc"/>
    <bpmn:sequenceFlow id="seq_15" sourceRef="e_acc" targetRef="e_excel"/>
    <bpmn:sequenceFlow id="seq_16" sourceRef="e_excel" targetRef="e_gw_wed"/>
    <bpmn:sequenceFlow id="seq_17" sourceRef="e_gw_wed" targetRef="e_dep" name="yes"/>
    <bpmn:sequenceFlow id="seq_18" sourceRef="e_gw_wed" targetRef="e_gw_wed_m" name="no"/>
    <bpmn:sequenceFlow id="seq_19" sourceRef="e_dep" targetRef="e_gw_wed_m"/>
    <bpmn:sequenceFlow id="seq_20" sourceRef="e_gw_wed_m" targetRef="e_print"/>
    <bpmn:sequenceFlow id="seq_21" sourceRef="e_print" targetRef="e_chg"/>
    <bpmn:sequenceFlow id="seq_22" sourceRef="e_chg" targetRef="e_call"/>
    <bpmn:sequenceFlow id="seq_23" sourceRef="e_call" targetRef="k_prep"/>
    <bpmn:sequenceFlow id="seq_24" sourceRef="k_prep" targetRef="d_del"/>
    <bpmn:sequenceFlow id="seq_25" sourceRef="d_del" targetRef="e_inv"/>
    <bpmn:sequenceFlow id="seq_26" sourceRef="e_inv" targetRef="o_rec"/>
    <bpmn:sequenceFlow id="seq_27" sourceRef="o_rec" targetRef="o_end"/>
    <bpmn:textAnnotation id="note_legend"><bpmn:text>Red = pain point named by a stakeholder (P1-P13). See 02_table_asis-pain-points-to-stories.md for sources and the user stories that fix each one.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_asis"><bpmndi:BPMNPlane id="plane_asis" bpmnElement="collab_asis">
    <bpmndi:BPMNShape id="p_customer_di" bpmnElement="p_customer" isHorizontal="true"><dc:Bounds x="80" y="40" width="2590" height="115"/></bpmndi:BPMNShape>
